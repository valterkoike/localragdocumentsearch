@inherits LayoutComponentBase

<div class="page bg-light min-vh-100">
    <main>
        <!-- Enterprise Top Navigation -->
        <nav class="navbar navbar-expand-md navbar-dark shadow-sm" style="background-color: #1e293b;">
            <div class="container-fluid px-4">
                <a class="navbar-brand d-flex align-items-center" href="">
                    <span class="bi bi-cpu-fill me-2 text-primary"></span>
                    <span class="fw-bold tracking-wide">🔎 OfflineDocSearch</span>
                </a>
                
                <div class="collapse navbar-collapse justify-content-end">
                    <NavMenu />
                </div>
            </div>
        </nav>

        <!-- Main Content Area -->
        <article class="content px-4 py-4 mx-auto" style="max-width: 1200px;">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>