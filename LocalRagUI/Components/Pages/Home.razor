@page "/"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject HttpClient Http
@using LocalRagUI.Models

<h3>Home</h3>

<div class="input-group mb-3">
    <!-- The text input is disabled when isProcessing is true -->
    <input type="text" 
           class="form-control" 
           placeholder="Ask a question about your documents..." 
           @bind="userQuestion" 
           @bind:event="oninput" 
           @onkeydown="HandleKeyDown"
           disabled="@isLoading" />

    <!-- The submit button is also disabled, and shows a spinner if processing -->
    <button class="btn btn-primary px-4" 
            @onclick="SubmitQuery" 
            disabled="@isLoading">
        @if (isLoading)
        {
            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
            <span>Thinking...</span>
        }
        else
        {
            <span>Search Knowledge Base</span>
        }
    </button>
</div>

@if (!string.IsNullOrEmpty(errorMessage)) {
    <div class="alert alert-danger">@errorMessage</div>
}

@if (responseModel != null) {
    <div class="card mt-4">
        <div class="card-body">
            <h5 class="card-title">Answer</h5>
            <p class="card-text" style="white-space: pre-line;">@responseModel.Answer</p>
            
            @if (responseModel.Sources != null && responseModel.Sources.Count > 0) {
                <h6 class="mt-3">Sources:</h6>
                <ul>
                    @{
                        // Group by the filename (everything before " (Page") and grab the first instance of each
                        var uniqueSources = responseModel.Sources
                            .GroupBy(s => s.Split(" (Page")[0])
                            .Select(group => group.First());
                    }
                    
                    @foreach (var source in uniqueSources) {
                        <li>
                            <a href="@GetPdfUrl(source)" target="_blank" rel="noopener noreferrer">
                                @source
                            </a>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>
}

@code {
    private string userQuestion = "";
    private QueryResponse? responseModel;
    private bool isLoading = false;
    private string errorMessage = "";

    private async Task SubmitQuery()
    {
        if (string.IsNullOrWhiteSpace(userQuestion)) return;

        isLoading = true;
        errorMessage = "";
        responseModel = null;

        try
        {
            var request = new QueryRequest { Question = userQuestion };
            var response = await Http.PostAsJsonAsync("/query", request);
            
            if (response.IsSuccessStatusCode)
            {
                responseModel = await response.Content.ReadFromJsonAsync<QueryResponse>();
            }
            else
            {
                errorMessage = $"Server error: {response.ReasonPhrase}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to connect to backend: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
    
    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !isLoading && !string.IsNullOrWhiteSpace(userQuestion))
        {
            await SubmitQuery();
        }
    }
    
    private string GetPdfUrl(string source)
    {
        try
        {
            // source looks like "Policies and Procedures.pdf (Page 4)"
            var parts = source.Split(" (Page ");
            
            // 1. Grab the filename
            string filename = parts[0].Trim();
            
            // 2. Grab the page number (or default to 1)
            string page = parts.Length > 1 ? parts[1].Replace(")", "").Trim() : "1";
            
            // 3. URL-Encode the filename
            string encodedFilename = Uri.EscapeDataString(filename);
            
            return $"http://127.0.0.1:8000/documents/{encodedFilename}#page={page}";
        }
        catch
        {
            return "#";
        }
    }
}